# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fish Audio TTS (선택사항 - 팟캐스트/강의 음성 생성용)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# Fish Audio 음성 모델 ID (https://fish.audio/ko-KR/ 에서 확인)
# 진행자(Host) 음성 모델 ID
FISH_AUDIO_HOST_VOICE_ID=your_host_voice_model_id
# 게스트(Guest) 음성 모델 ID
FISH_AUDIO_GUEST_VOICE_ID=your_guest_voice_model_id

# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./ai_learning.db

# File Storage
DATA_DIR=../data
SOURCES_DIR=../data/sources
CONTENT_DIR=../data/content
AUDIO_DIR=../data/audio
VIDEOS_DIR=../data/videos

# AI Settings
AI_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS=4096
TEMPERATURE=0.7

# CORS
FRONTEND_URL=http://localhost:3000
